# =============================================================================
# Supabase 接続情報
# 取得先: Supabaseダッシュボード → Project Settings → API
#
# ローカル開発・テストは必ず「開発用プロジェクト」のURLを使用すること。
# 本番プロジェクトのURLをここに入力してはいけない。
# =============================================================================

# Supabaseプロジェクトの公開URL（例: https://xxxxxxxxxx.supabase.co）
# 参照箇所: src/lib/supabase.ts, src/middleware.ts, src/app/auth/callback/route.ts
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co

# Supabaseの匿名キー（公開可。RLSで行レベルの権限を制御する）
# 参照箇所: src/lib/supabase.ts, src/middleware.ts, src/app/auth/callback/route.ts
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabaseのサービスロールキー（RLSをバイパスする強力なキー。絶対に公開しないこと）
# 参照箇所: src/app/api/keepalive/route.ts（Cronジョブ内のDB死活確認）
# 取得先: Supabaseダッシュボード → Project Settings → API → service_role
# 管理: パスワードマネージャー（Evernote）で保管。SlackやGitHubには絶対に貼らないこと
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# アプリケーションURL
# パスワードリセットメールのリダイレクト先URLを構成するために使用する。
# 参照箇所: src/app/change-password/page.tsx
# =============================================================================

# このアプリのベースURL
# ローカル: http://localhost:3000
# テスト:   https://survey-app-git-develop-tom-5990s-projects.vercel.app
# 本番:     https://tom-survey-app.vercel.app
# ※ VercelのProduction環境変数にのみ設定する（未設定時は window.location.origin を使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Vercel Cron 認証シークレット
# /api/keepalive エンドポイントへの不正アクセスを防ぐための共有シークレット。
# 参照箇所: src/app/api/keepalive/route.ts
# 設定方法: openssl rand -hex 32 などで生成した文字列を使用する。
#           Vercelダッシュボードの環境変数と同じ値を設定すること。
# =============================================================================
CRON_SECRET=your-cron-secret
